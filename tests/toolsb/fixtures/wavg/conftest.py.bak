def case3_wavg(_case3: _Case3, case3_isok: bool, values2d_units) -> pd.Series:
    if not case3_isok:
        pytest.skip("Error case.")
    return pd.Series(_case3.wavg, "Eur/MWh" if values2d_units != "valuesnounits" else "Eur/MWh")

