# 1d values, 1d weights


@dataclasses.dataclass
class _Case2:
    values1d: np.ndarray
    weights1d: np.ndarray
    wavg: float | Exception

    def __post_init__(self):
        if isinstance(self.values1d, _Values1d):
            self.values1d = self.values1d.value
        self.values1d = np.array(self.values1d)
        if isinstance(self.weights1d, _Weights1d):
            self.weights1d = self.weights1d.value
        self.weights1d = np.array(self.weights1d)


