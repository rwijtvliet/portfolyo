)
def _case3(request) -> _Case3:
    return _Case3(*request.param)


def _change_dtype(df: pd.DataFrame, values2d_units: str) -> pd.DataFrame:
    if values2d_units == "valuesnounits":
        return df.astype(float)
    elif values2d_units == "valuesuniformunits":
        return df.astype("pint[Eur/MWh]")
    else:
        series = {}
        for i, (col, s) in enumerate(df.items()):
            if i == 0:
                series[col] = s.astype("pint[Eur/MWh]")
            elif values2d_units == "valuescompatibleunits":
                series[col] = (s / 10).astype("pint[ctEur/kWh]")
            else:  # values2d_units == 'valuesincompatibleunits'
                series[col] = s.astype("pint[Eur]")
        return pd.DataFrame(series)


def _dataframe(
    numbers: np.ndarray, rowindex: Sequence, colindex: Sequence, values2d_units: str
) -> pd.DataFrame:
    df = pd.DataFrame(numbers, rowindex[: numbers.shape[0]], colindex[: numbers.shape[1]])
    return _change_dtype(df, values2d_units)


@pytest.fixture(scope="class")
def case3_values(
    _case3: _Case3, rowindex: Sequence, colindex: Sequence, values2d_units: str
) -> pd.DataFrame:
    return _dataframe(_case3.values2d, rowindex, colindex, values2d_units)


@pytest.fixture(scope="class")
def case3_axis(_case3: _Case3) -> int:
    return _case3.axis


@pytest.fixture(scope="class")
def case3_isok(values2d_units: str, case3_axis) -> bool:
    return not (values2d_units == "valuesincompatibleunits" and case3_axis == 1)


