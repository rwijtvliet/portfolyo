@pytest.fixture(
    scope="module",
    params=[
        pytest.param(list, id="weightsaslist"),
        pytest.param(tuple, id="weightsastuple"),
        pytest.param(dict, id="weightsasdict"),
        pytest.param(pd.Series, id="weightsasseries"),
    ],
)
def weights1d_as(request) -> type:
    return request.param


def _weights1d(
    weights1d_values: Iterable,
    weights1d_as: type,
    weights_rowindex: Iterable,
    weights_has_units: bool,
) -> list | tuple | dict | pd.Series:
    addunitsfn = lambda x: (Q_(x, "MWh") if weights_has_units else x)  # noqa

    # Non-mappings.
    if weights1d_as in [list, tuple]:
        return weights1d_as(addunitsfn(w) for w in weights1d_values)

    # Mappings. Reverse order to test mapping on keys.
    mapping = dict(reversed(list(zip(weights_rowindex, weights1d_values))))
    if weights1d_as is dict:
        return {k: addunitsfn(v) for k, v in mapping.items()}
    else:  # pd.Series
        s = pd.Series(mapping)
        return s.astype("pint[MWh]") if weights_has_units else s


